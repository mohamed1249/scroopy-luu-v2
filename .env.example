# Default is local MongoDB. Set this in your shell to override it.
# This application does not automatically load .env files.
MONGODB_URI=mongodb://127.0.0.1:27017/
# Required: generate your own random value. Empty means scraping is disabled.
SCROOPY_API_KEY=
# Optional legacy Google Drive workflow:
SCROOPY_DRIVE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
